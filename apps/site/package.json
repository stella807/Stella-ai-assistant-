{
  "name": "@safehubby/site",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "dev": "node --experimental-strip-types src/build.ts && node --experimental-strip-types src/serve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@safehubby/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
