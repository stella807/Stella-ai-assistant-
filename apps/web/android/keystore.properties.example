# Copy to keystore.properties (gitignored) after creating your upload key:
#
#   keytool -genkey -v -keystore safehubby-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias safehubby
#
# Keep the .jks file and these passwords somewhere you will not lose them.
# Google Play Signing means a lost upload key can be reset by support, but
# losing it without Play Signing enrolled means you can never update the app.
storeFile=../safehubby-upload.jks
storePassword=CHANGEME
keyAlias=safehubby
keyPassword=CHANGEME
