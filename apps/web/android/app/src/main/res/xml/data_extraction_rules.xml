<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up off the device.

  Cloud backup would copy the session cookie and any cached night — including
  location history — into Google's backup, outside the encryption this app
  applies on the server. For a product whose whole premise is careful handling
  of location, opting out is the only defensible setting.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
